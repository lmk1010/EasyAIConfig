{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EasyAIConfig",
  "version": "1.0.69",
  "identifier": "com.easyai.config",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "EasyAIConfig",
        "width": 1120,
        "height": 760,
        "minWidth": 980,
        "minHeight": 660,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#090c12",
        "theme": "Dark",
        "trafficLightPosition": {
          "x": 6,
          "y": 14
        }
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: https://tauri.localhost ipc: http://ipc.localhost; img-src 'self' tauri: https://tauri.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval' tauri:; connect-src 'self' tauri: ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* https://api.github.com https://github.com https://*.githubusercontent.com; font-src 'self' data:; frame-src 'none'; object-src 'none'; base-uri 'self'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "easyai",
          "easyaiconfig",
          "ccswitch"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/lmk1010/EasyAIConfig/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZEQkRGQjdGOTdBQkI0ClJXUzBxNWQvKzczOUFEbDFSZ1VRTWxIaitBZ3pMU21EekJud0NCRkw1MWIzbXZ6UWtnUUszaUZFCg==",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
